# Where's Karl clients — public environment variables
#
# Web app local setup:
#   cp apps/web/.env.example apps/web/.env.local
#
# Universal (still at whereskarl-universal until a later migration phase)
# uses EXPO_PUBLIC_API_URL in its own local env setup.
#
# Never commit .env.local files or real secrets.

# Shared Where's Karl backend base URL for the Next.js web app (no trailing slash).
NEXT_PUBLIC_API_URL=
