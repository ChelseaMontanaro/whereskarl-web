# Where's Karl clients — public environment variables
#
# Web app local setup:
#   cp apps/web/.env.example apps/web/.env.local
#
# Universal app local setup (apps/universal):
#   cp apps/universal/.env.example apps/universal/.env
# uses EXPO_PUBLIC_API_URL (never commit real secrets).
#
# Never commit .env.local files or real secrets.

# Shared Where's Karl backend base URL for the Next.js web app (no trailing slash).
NEXT_PUBLIC_API_URL=
