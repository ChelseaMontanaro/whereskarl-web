{
  "expo": {
    "name": "Where's Karl",
    "slug": "whereskarl",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "whereskarluniversal",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "whereskarl.live.app",
      "buildNumber": "7",
      "appleTeamId": "5CNF3D3CGN",
      "icon": "./assets/images/wheres-karl-app-icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030B14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Where's Karl uses your location to show the nearest Bay Area weather spot on the map.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "motionUsagePermission": "Where's Karl does not track your motion or fitness activity. Motion access is included by the location software used by the app."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "877e9ea7-01b1-4735-83e0-e023a2c038fe"
      }
    },
    "owner": "whereskarl"
  }
}
