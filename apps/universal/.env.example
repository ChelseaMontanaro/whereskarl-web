# Where's Karl universal (Expo) — public environment variables
#
# Copy to `.env` for local development.
# Never commit `.env` or real secrets.

# Shared Where's Karl backend base URL (no trailing slash).
# Local: point at your running WheresKarl-Backend instance.
# Production: https://api.whereskarl.live
EXPO_PUBLIC_API_URL=

# Selected-location circular thumbnails consume backend `imageUrl` and
# `focalPoint` from GET /locations. If thumbnails show "Coming Soon" while
# weather is live, set HERO_CDN_BASE_URL on WheresKarl-Backend (see backend
# .env.example), then restart the backend. Universal does not resolve imagery
# client-side.
